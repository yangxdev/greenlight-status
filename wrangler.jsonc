/*
  Cloudflare Workers with static assets: the built SPA in ./dist is served from the edge, and requests under
  /api/* run worker/index.ts first. Same shape as waypoint and yangxdev.com.

  Deployed by the Publisher (.github/workflows/deploy.yml) with `wrangler deploy`.
  Local full stack: `npm run build && npx wrangler dev`.
*/
{
  "name": "greenlight-status",
  "main": "worker/index.ts",
  // Dates >= 2026-08-04 enable Node.js compatibility by default; the flag stays explicit anyway (MongoDB driver).
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "SOURCE_REPO": "yangxdev/greenlight" },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get index.html, so client-side routes survive a reload.
    "not_found_handling": "single-page-application",
    // Without this the assets layer answers first and /api/* would get the SPA shell instead of the Worker.
    "run_worker_first": ["/api/*"],
  },

  // Uncomment when the blueprint needs file storage. Create the bucket first:
  //   npx wrangler r2 bucket create greenlight-status-files
  // "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "greenlight-status-files" }],

  // Secrets (MONGODB_URI, ...) are NOT stored here. Set them with:
  //   npx wrangler secret put MONGODB_URI
}
